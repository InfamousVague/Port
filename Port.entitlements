<?xml version="1.0" encoding="UTF-8"?>
<!--
  Port host entitlements. Must declare the same App Group as the
  widget extension at Widget/Supporting Files/PortWidgets.entitlements
  so SharedPortStore.write can resolve the Group Container URL. Drift
  in the group id between this and the widget's file is a silent
  failure — the JSON is written somewhere the widget can't read.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>com.apple.security.application-groups</key>
  <array>
    <string>F6ZAL7ANAD.group.com.mattssoftware.port</string>
  </array>
</dict>
</plist>
